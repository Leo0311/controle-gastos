spring.application.name=controle-gastos-api

# Mesmo banco PostgreSQL usado pela aplicacao de console (controle-gastos)
# Copie este arquivo para "application.properties" e ajuste os valores conforme o seu ambiente
spring.datasource.url=jdbc:postgresql://localhost:5432/controle_gastos
spring.datasource.username=postgres
spring.datasource.password=SUA_SENHA_AQUI
spring.datasource.driver-class-name=org.postgresql.Driver

# Reescreve INSERT em lote (JdbcTemplate.batchUpdate) num unico INSERT multi-linha -
# a pre-geracao de gastos recorrentes usa isso (achado 2.3). Copie esta linha pro
# seu application.properties.
spring.datasource.hikari.data-source-properties.reWriteBatchedInserts=true

# O Flyway roda as migrations (db/migration/V*.sql) no boot, antes do Hibernate.
# baseline-on-migrate: num banco que ja tem as tabelas mas nao tem
# flyway_schema_history, o V1 e registrado como BASELINE e nao executado; num
# banco vazio o V1 roda inteiro.
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
spring.flyway.baseline-description=baseline
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# JWT - gere um segredo aleatorio de pelo menos 32 bytes (base64), por exemplo:
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
app.jwt.secret=SEU_SEGREDO_JWT_AQUI

app.frontend.url=http://localhost:4200

# E-mail (Gmail SMTP) - use um email de app (nao a senha normal da conta)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=SEU_EMAIL_AQUI
spring.mail.password=SUA_SENHA_DE_APP_AQUI
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
